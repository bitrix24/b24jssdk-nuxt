{
  "name": "@bitrix24/b24jssdk-nuxt",
  "version": "0.5.1",
  "packageManager": "pnpm@10.20.0",
  "author": "Bitrix",
  "license": "MIT",
  "description": "Bitrix24 REST API JS SDK for Nuxt",
  "keywords": [
    "bitrix24",
    "restapi",
    "nuxt"
  ],
  "homepage": "https://bitrix24.github.io/b24jssdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitrix24/b24jssdk-nuxt.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime/*": "./dist/runtime/*"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ],
      "runtime/*": [
        "./dist/runtime/*"
      ]
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "prepack": "pnpm build",
    "build": "nuxt-module-build build",
    "dev": "DEV=true nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:generate": "nuxt generate playground",
    "dev:preview": "nuxt preview playground",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nuxt/kit": "^4.1.3",
    "@bitrix24/b24jssdk": "^0.5.1",
    "axios": "^1.12.2",
    "qs-esm": "^7.0.2",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@nuxt/devtools": "^2.6.5",
    "@nuxt/eslint-config": "^1.9.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.1.3",
    "@nuxt/test-utils": "^3.19.2",
    "@types/node": "^24.7.0",
    "@types/luxon": "^3.7.1",
    "eslint": "^9.37.0",
    "nuxt": "^4.1.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
